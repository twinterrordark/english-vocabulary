[
{"id":"topic-70","cat":"street","emoji":"⚡","tr":"Kısa tepkiler","en":"Quick Reactions","tip":"Bu kısa cevaplar konuşmayı canlı tutar. Tek kelimelik \"Yes\" ya da \"No\" yerine bunları kullanmak çok daha doğal duyulur.","dialog":[["I just quit my job.","Az önce işten ayrıldım."],["No way! Are you serious?","Olamaz! Ciddi misin?"],["Yep. I'd had enough.","Evet. Yeter artık demiştim."],["Fair enough. Good for you!","Haklısın. Helal olsun!"]],"groups":[{"h":["Surprise","Şaşırma"],"items":[["No way!","Olamaz! / Hadi canım!"],["Seriously?","Ciddi misin?"],["You're kidding!","Şaka yapıyorsun!"],["Are you serious?","Ciddi misin?",[["positive","Yeah, I'm dead serious.","Evet, son derece ciddiyim."],["neutral","Nah, just kidding.","Yok, şaka yapıyorum."]]],["For real?","Gerçekten mi?",[["positive","For real. I saw it myself.","Gerçekten. Kendi gözlerimle gördüm."]]],["Wow, that's crazy!","Vay, bu çılgınca!"],["I can't believe it!","İnanamıyorum!"]]},{"h":["Agreeing","Onaylama"],"items":[["Totally.","Kesinlikle."],["Exactly.","Aynen."],["Fair enough.","Haklısın. / Makul."],["Sounds good.","İyi fikir. / Olur."],["You bet.","Tabii ki. / Ne demek."],["Same here.","Bende de öyle."],["Tell me about it.","Bana mı diyorsun. / Sorma."],["I know, right?","Değil mi ama?"]]},{"h":["Not sure or not interested","Emin değil ya da ilgisiz"],"items":[["Maybe.","Belki."],["I guess so.","Sanırım öyle."],["Not really.","Pek değil."],["Who knows?","Kim bilir?"],["Whatever.","Her neyse. (biraz kaba olabilir)"],["I don't mind.","Benim için fark etmez."],["It's up to you.","Sana kalmış."]]},{"h":["Kind reactions","Nazik tepkiler"],"items":[["That's great!","Bu harika!"],["Good for you!","Aferin sana! / Ne güzel!"],["Lucky you!","Şanslısın!"],["That's too bad.","Çok yazık."],["Oh no, I'm sorry to hear that.","Ah, bunu duyduğuma üzüldüm."],["Hang in there.","Dayan. / Pes etme."]]}]},
{"id":"topic-71","cat":"street","emoji":"🧢","tr":"Arkadaş arası konuşma","en":"Casual Talk with Friends","tip":"Bunlar samimi ifadelerdir; arkadaşla rahatça kullanılır ama iş görüşmesinde ya da resmî yazıda kullanılmaz.","dialog":[["Hey, what's up?","Selam, n'aber?"],["Not much. Just chilling. You?","Pek bir şey yok. Takılıyorum. Sen?"],["Same. Wanna hang out later?","Aynı. Sonra takılalım mı?"],["Sure, I'm down.","Olur, varım."]],"groups":[{"h":["Greeting a friend","Arkadaşı selamlama"],"items":[["What's up?","N'aber?",[["positive","Not much. What's up with you?","Pek bir şey yok. Sende n'aber?"],["neutral","Just got home from work.","İşten yeni geldim."]]],["How's it going?","Nasıl gidiyor?",[["positive","Pretty good, thanks.","Gayet iyi, sağ ol."],["negative","Could be better, to be honest.","Açıkçası daha iyi olabilirdi."]]],["What have you been up to?","Neler yapıyorsun bu aralar?",[["positive","Not much, just working a lot.","Pek bir şey yok, çok çalışıyorum."]]],["Long time no see!","Görüşmeyeli çok oldu!"],["See you later!","Görüşürüz!"],["Catch you later.","Sonra görüşürüz."],["Take it easy.","Kendine iyi bak. / Rahat ol."]]},{"h":["Everyday street words","Sokakta duyacağın kelimeler"],"items":[["I'm broke.","Beş parasızım."],["I'm beat.","Çok yorgunum."],["I'm starving.","Açlıktan ölüyorum."],["My bad.","Benim hatam."],["No worries.","Sorun değil."],["No big deal.","Büyütecek bir şey yok."],["That's sick!","Bu çok iyi! (argo)"],["It's a rip-off.","Bu kazık. / Çok pahalı."],["Chill out.","Sakin ol."],["I'm down.","Varım."],["I'm in.","Ben de varım."],["I'm out.","Ben yokum. / Ben kaçtım."]]},{"h":["Hanging out","Takılma"],"items":[["Wanna hang out?","Takılalım mı?",[["positive","Sure. When are you free?","Olur. Ne zaman boşsun?"],["negative","Can't today. Maybe tomorrow?","Bugün olmaz. Yarın olur mu?"]]],["Let's grab a bite.","Bir şeyler atıştıralım."],["Let's grab a coffee.","Bir kahve içelim."],["What's the plan?","Plan ne?",[["positive","Dinner first, then a film.","Önce yemek, sonra film."]]],["I'm running late.","Geç kalıyorum."],["I'll be there in five.","Beş dakikaya oradayım."],["Text me when you get there.","Oraya varınca mesaj at."],["I gotta go.","Gitmem lazım."]]}]},
{"id":"topic-72","cat":"street","emoji":"🗣️","tr":"Hızlı konuşmada duyulanlar","en":"Fast Speech","tip":"Yazıda \"going to\" görürsün, konuşmada \"gonna\" duyarsın. Bunları özellikle dinlerken tanımak önemlidir; resmî yazıda kullanma.","dialog":[["Whatcha doing tonight?","Bu gece ne yapıyorsun?"],["Dunno. I'm gonna stay in, I guess.","Bilmem. Sanırım evde kalacağım."],["Wanna come over?","Bize gelmek ister misin?"],["Lemme check. I gotta finish some work.","Bir bakayım. Biraz iş bitirmem lazım."]],"groups":[{"h":["Very common","Çok yaygın olanlar"],"items":[["I'm gonna call you. (going to)","Seni arayacağım."],["I wanna go home. (want to)","Eve gitmek istiyorum."],["I gotta leave. (got to)","Gitmem lazım."],["I dunno. (I don't know)","Bilmiyorum."],["Lemme see. (let me)","Bir bakayım."],["Gimme a second. (give me)","Bir saniye ver."],["It's kinda cold. (kind of)","Biraz soğuk."],["I'm sorta tired. (sort of)","Biraz yorgunum."]]},{"h":["In questions","Sorularda"],"items":[["Whatcha doing? (what are you)","Ne yapıyorsun?",[["positive","Nothing much. Watching TV.","Pek bir şey. Televizyon izliyorum."]]],["Didja see that? (did you)","Bunu gördün mü?",[["positive","Yeah, that was crazy!","Evet, çılgıncaydı!"],["negative","No, what happened?","Hayır, ne oldu?"]]],["Wanna come? (do you want to)","Gelmek ister misin?",[["positive","Yeah, sounds fun.","Evet, eğlenceli olur."],["negative","Nah, I'm good.","Yok, kalsın."]]],["Y'know what I mean? (you know)","Ne demek istediğimi anlıyor musun?",[["positive","Yeah, totally.","Evet, kesinlikle."]]],["Whaddaya think? (what do you)","Ne düşünüyorsun?",[["positive","Looks good to me.","Bence iyi görünüyor."]]]]},{"h":["Short yes and no","Kısa evet ve hayır"],"items":[["Yeah.","Evet."],["Yep.","Hı hı. / Evet."],["Nope.","Yok. / Hayır."],["Nah.","Yok ya."],["Uh-huh.","Hı hı. (evet)"],["Uh-uh.","Yok. (hayır)"],["Sure thing.","Tabii."]]}]},
{"id":"topic-73","cat":"street","emoji":"💬","tr":"Dolgu ifadeler","en":"Filler Words","tip":"Takıldığında susmak yerine bunları kullan: düşünmek için zaman kazandırır, konuşman daha akıcı duyulur. Abartma; \"like\" her cümlede itici olur.","dialog":[["So, how was the trip?","Eee, gezi nasıldı?"],["Well, it was, you know, kind of tiring.","Şey, biraz yorucuydu işte."],["What do you mean?","Ne demek istiyorsun?"],["I mean, the food was great, but we walked all day.","Yani yemekler harikaydı ama bütün gün yürüdük."]],"groups":[{"h":["Buying time","Zaman kazanma"],"items":[["Well...","Şey..."],["Let me think.","Düşüneyim."],["Hmm, let me see.","Hmm, bir bakayım."],["How can I put it?","Nasıl desem?"],["What's the word?","Kelime neydi?"],["It's on the tip of my tongue.","Dilimin ucunda."]]},{"h":["Connecting ideas","Fikirleri bağlama"],"items":[["You know...","Biliyorsun... / İşte..."],["I mean...","Yani..."],["Actually,","Aslında,"],["Basically,","Kısacası,"],["Anyway,","Neyse,"],["By the way,","Bu arada,"],["The thing is,","Mesele şu ki,"],["To be honest,","Açıkçası,"],["Like I said,","Dediğim gibi,"]]},{"h":["Checking and fixing","Kontrol ve düzeltme"],"items":[["You know what I mean?","Ne demek istediğimi anlıyor musun?",[["positive","Yeah, I get it.","Evet, anladım."],["negative","Not really. Can you explain?","Pek değil. Açıklayabilir misin?"]]],["Does that make sense?","Anlaşılıyor mu?",[["positive","Yes, that makes sense.","Evet, anlaşılıyor."],["negative","Sorry, could you say it another way?","Üzgünüm, başka türlü söyleyebilir misin?"]]],["Sorry, what I meant was...","Pardon, demek istediğim şuydu..."],["Wait, let me start again.","Dur, baştan başlayayım."],["How do you say this in English?","Bunu İngilizce nasıl söylersin?",[["positive","We usually say \"take it easy\".","Genellikle \"take it easy\" deriz."]]],["I don't get it.","Anlamadım."]]}]},
{"id":"topic-74","cat":"street","emoji":"🚶","tr":"Sokakta kısa konuşmalar","en":"Out on the Street","tip":"İngilizcede yabancılara \"Excuse me\" ile başlamak çok önemlidir; doğrudan soru sormak kaba bulunabilir.","dialog":[["Excuse me, you dropped this.","Affedersiniz, bunu düşürdünüz."],["Oh, thanks a lot!","Aa, çok teşekkürler!"],["No problem. Have a nice day.","Sorun değil. İyi günler."],["You too!","Size de!"]],"groups":[{"h":["Small moments","Küçük anlar"],"items":[["Excuse me, you dropped this.","Affedersiniz, bunu düşürdünüz."],["After you.","Önce siz buyurun."],["Sorry, my mistake.","Pardon, benim hatam."],["Watch out!","Dikkat et!"],["Mind your head.","Başına dikkat et."],["Coming through!","Geçiyorum, yol verin!"],["Have a good one.","İyi günler."]]},{"h":["Asking quickly","Hızlıca sorma"],"items":[["Is this the line?","Sıra burası mı?",[["positive","Yeah, the end's over there.","Evet, sonu şurada."],["negative","No, this is for tickets only.","Hayır, burası sadece bilet için."]]],["Are you in line?","Sırada mısınız?",[["positive","Yes, sorry.","Evet, kusura bakmayın."],["negative","No, go ahead.","Hayır, buyurun."]]],["Do you have the time?","Saatiniz var mı? (Saat kaç?)",[["positive","Yeah, it's ten past two.","Evet, ikiyi on geçiyor."],["negative","Sorry, my phone's dead.","Üzgünüm, telefonumun şarjı bitti."]]],["Could you take a picture of us?","Bizim bir fotoğrafımızı çekebilir misiniz?",[["positive","Sure. Say cheese!","Tabii. Gülümseyin!"]]],["Is this bus going downtown?","Bu otobüs şehir merkezine gidiyor mu?",[["positive","Yep, it stops right there.","Evet, tam orada duruyor."],["negative","No, you need the number ten.","Hayır, on numaraya binmeniz lazım."]]],["Do you know a good place to eat around here?","Buralarda yemek yenecek iyi bir yer biliyor musunuz?",[["positive","Yeah, try the place on the corner.","Evet, köşedeki yeri deneyin."]]],["Is it far from here?","Buradan uzak mı?",[["positive","No, it's just around the corner.","Hayır, hemen köşede."],["negative","Yeah, you'd better take a taxi.","Evet, taksiye binseniz iyi olur."]]]]}]},
{"id":"topic-75","cat":"street","emoji":"🥤","tr":"Dükkân ve kafede hızlı konuşma","en":"Quick Talk in Shops and Cafés","tip":"Günlük hayatta \"Can I get...?\" çok yaygındır; \"I want\" kaba duyulabilir.","dialog":[["What can I get you?","Ne alırsınız?"],["Can I get a large coffee to go?","Büyük boy bir kahve alabilir miyim, götürmek için?"],["Anything else?","Başka bir şey?"],["That's it, thanks.","Bu kadar, teşekkürler."]],"groups":[{"h":["At the café","Kafede"],"items":[["Can I get a coffee?","Bir kahve alabilir miyim?",[["positive","Sure. What size?","Tabii. Hangi boy?"]]],["For here or to go?","Burada mı, götürmek için mi?",[["positive","To go, please.","Götürmek için lütfen."],["neutral","For here, thanks.","Burada, teşekkürler."]]],["Is that everything?","Hepsi bu kadar mı?",[["positive","Yes, that's it.","Evet, bu kadar."],["neutral","Actually, can I get a water too?","Aslında bir su da alabilir miyim?"]]],["Keep the change.","Üstü kalsın."],["It's on me.","Benden olsun."],["Let's split the bill.","Hesabı bölüşelim."]]},{"h":["In a shop","Dükkânda"],"items":[["Can I help you?","Yardımcı olabilir miyim?",[["positive","I'm just looking, thanks.","Sadece bakıyorum, teşekkürler."],["neutral","Yes, do you have this in blue?","Evet, bunun mavisi var mı?"]]],["I'm just looking.","Sadece bakıyorum."],["How much is this?","Bu ne kadar?",[["positive","It's twenty bucks.","Yirmi dolar."]]],["Do you have a smaller size?","Daha küçük bedeni var mı?",[["positive","Let me check in the back.","Arkaya bakayım."],["negative","Sorry, that's the last one.","Üzgünüm, bu son kalan."]]],["That's a good deal.","Bu iyi bir fiyat."],["Do you take cards?","Kart geçiyor mu?",[["positive","Yeah, just tap here.","Evet, buraya dokundurun."],["negative","Sorry, cash only.","Üzgünüm, sadece nakit."]]],["I'll take it.","Alıyorum."],["I'll think about it.","Bir düşüneyim."]]}]},
{"id":"topic-76","cat":"street","emoji":"🔥","tr":"Duygular: günlük dilde","en":"Feelings in Everyday Talk","tip":"\"I'm so done\" bir şeyden bıkmayı anlatır, \"bitirdim\" demek değildir. Bağlam önemlidir.","dialog":[["You look stressed. What's up?","Stresli görünüyorsun. Ne oldu?"],["I'm so done with this project.","Bu projeden bıktım usandım."],["Take a break. You've earned it.","Mola ver. Hak ettin."],["You're right. I need some fresh air.","Haklısın. Biraz temiz havaya ihtiyacım var."]],"groups":[{"h":["Good feelings","İyi duygular"],"items":[["I'm so excited!","Çok heyecanlıyım!"],["I'm on cloud nine.","Havalara uçuyorum."],["That made my day.","Günümü güzelleştirdi."],["I can't wait!","Sabırsızlanıyorum!"],["It was a blast.","Çok eğlenceliydi."],["I love it!","Bayıldım!"]]},{"h":["Bad feelings","Kötü duygular"],"items":[["I'm so done.","Bıktım usandım."],["I'm fed up with this.","Bundan bıktım."],["That's so annoying.","Bu çok sinir bozucu."],["This sucks.","Bu berbat. (kaba sayılabilir)"],["I'm freaking out.","Panikliyorum."],["I'm stressed out.","Çok stresliyim."],["That's gross!","İğrenç!"],["I feel awful.","Berbat hissediyorum."]]},{"h":["Calming someone","Birini sakinleştirme"],"items":[["Calm down.","Sakin ol."],["It's not a big deal.","Büyütecek bir şey değil."],["Don't worry about it.","Kafana takma."],["It'll be fine.","Her şey iyi olacak."],["Are you okay?","İyi misin?",[["positive","Yeah, I'm fine, thanks.","Evet, iyiyim, sağ ol."],["negative","Not really. It's been a rough day.","Pek değil. Zor bir gündü."]]],["What's wrong?","Ne oldu?",[["positive","Nothing. I'm just tired.","Bir şey yok. Sadece yorgunum."],["negative","I had a fight with my brother.","Kardeşimle tartıştım."]]]]}]},
{"id":"topic-77","cat":"street","emoji":"📲","tr":"Mesajlaşma kısaltmaları","en":"Texting Abbreviations","tip":"Bunlar yalnızca mesajlaşmada kullanılır, sesli söylenmez (LOL hariç bazen). İş e-postasında kullanma.","dialog":[["BTW, are you coming tonight?","Bu arada, bu gece geliyor musun?"],["IDK yet. Lots of work, TBH.","Henüz bilmiyorum. Açıkçası çok iş var."],["LOL, same here. Tell me ASAP.","Haha, bende de öyle. En kısa sürede söyle."],["OK, BRB.","Tamam, hemen dönerim."]],"groups":[{"h":["Most common","En yaygın olanlar"],"items":[["LOL = laughing out loud","Haha, çok güldüm"],["BRB = be right back","Hemen dönerim"],["BTW = by the way","Bu arada"],["IDK = I don't know","Bilmiyorum"],["TBH = to be honest","Açıkçası"],["ASAP = as soon as possible","En kısa sürede"],["OMG = oh my God","Aman tanrım"],["THX = thanks","Teşekkürler"],["PLS = please","Lütfen"]]},{"h":["Others you will see","Göreceğin diğerleri"],"items":[["IMO = in my opinion","Bence"],["FYI = for your information","Bilgin olsun"],["NVM = never mind","Boş ver"],["TTYL = talk to you later","Sonra konuşuruz"],["GTG = got to go","Gitmem lazım"],["ICYMI = in case you missed it","Kaçırdıysan diye"],["DM = direct message","Özel mesaj"],["RN = right now","Şu anda"]]}]}
]
