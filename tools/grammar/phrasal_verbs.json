  "sets": [
    {
      "id": "pv-particle",
      "title": "Eksik edatı seç",
      "hint": "Phrasal verb'ü tamamlayan kelimeyi seç.",
      "items": [
        { "q": "I usually get ___ at seven o'clock.", "options": ["up", "on", "off", "out"], "answer": "up", "why": "get up = yataktan kalkmak." },
        { "q": "Can you look ___ my dog while I'm away?", "options": ["after", "for", "up", "into"], "answer": "after", "why": "look after = bakmak, ilgilenmek." },
        { "q": "I'm looking ___ my keys. Have you seen them?", "options": ["for", "after", "at", "up"], "answer": "for", "why": "look for = aramak." },
        { "q": "If you don't know the word, look it ___.", "options": ["up", "for", "after", "on"], "answer": "up", "why": "look up = sözlükte aramak." },
        { "q": "Please turn ___ the lights when you leave.", "options": ["off", "up", "out", "down"], "answer": "off", "why": "turn off = kapatmak." },
        { "q": "It's cold. Put ___ your jacket.", "options": ["on", "off", "up", "away"], "answer": "on", "why": "put on = giymek." },
        { "q": "The plane took ___ on time.", "options": ["off", "on", "up", "out"], "answer": "off", "why": "take off = (uçak) kalkmak." },
        { "q": "Don't give ___! You're nearly there.", "options": ["up", "in", "out", "off"], "answer": "up", "why": "give up = pes etmek." },
        { "q": "We have run ___ of sugar.", "options": ["out", "off", "away", "down"], "answer": "out", "why": "run out of = tükenmek." },
        { "q": "I want to find ___ what happened.", "options": ["out", "up", "off", "in"], "answer": "out", "why": "find out = öğrenmek." },
        { "q": "They put ___ the match until next week.", "options": ["off", "on", "out", "up"], "answer": "off", "why": "put off = ertelemek." },
        { "q": "I can't put up ___ his rudeness.", "options": ["with", "to", "for", "on"], "answer": "with", "why": "put up with = katlanmak." },
        { "q": "I'm looking forward ___ seeing you.", "options": ["to", "for", "at", "with"], "answer": "to", "why": "look forward to + -ing." },
        { "q": "We got ___ the bus at the museum.", "options": ["off", "out", "down", "away"], "answer": "off", "why": "Otobüsten inmek → get off." },
        { "q": "She takes ___ her mother. They have the same eyes.", "options": ["after", "over", "on", "up"], "answer": "after", "why": "take after = (aileden birine) çekmek." },
        { "q": "I grew ___ in Istanbul.", "options": ["up", "out", "on", "over"], "answer": "up", "why": "grow up = büyümek." },
        { "q": "Our car broke ___ on the way home.", "options": ["down", "up", "out", "off"], "answer": "down", "why": "break down = bozulmak." },
        { "q": "Fill ___ this form, please.", "options": ["in", "up", "on", "off"], "answer": "in", "why": "fill in = (form) doldurmak." },
        { "q": "Calm ___. It's only a spider.", "options": ["down", "up", "off", "out"], "answer": "down", "why": "calm down = sakinleşmek." },
        { "q": "Who came up ___ this idea?", "options": ["with", "to", "for", "on"], "answer": "with", "why": "come up with = (fikir) bulmak." },
        { "q": "I ran ___ my teacher at the cinema.", "options": ["into", "out", "away", "over"], "answer": "into", "why": "run into = rastlamak." },
        { "q": "The firefighters put ___ the fire.", "options": ["out", "off", "away", "down"], "answer": "out", "why": "put out = söndürmek." }
      ]
    },
